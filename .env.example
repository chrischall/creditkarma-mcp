CK_COOKIES=   # Optional. Leave blank to use the ContextMint Bridge browser-extension fallback (the renamed fetchproxy extension, same maintainer; public source + .sha256-checked releases at https://github.com/nullnet-app/contextmint-bridge/releases) — sign into creditkarma.com in the browser and the MCP reads CKAT + CKTRKID cookies automatically. Otherwise paste the Cookie header from DevTools.
CK_DISABLE_FETCHPROXY=   # Optional. Set to 1 to skip the fetchproxy fallback (headless / CI).
CK_DB_PATH=   # Optional: custom path for SQLite DB (default: ~/.creditkarma-mcp/transactions.db)
